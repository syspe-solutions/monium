# ================================================================
# Monium — variáveis de ambiente
#
# Copie este arquivo para ".env" (mesma pasta) e ajuste os valores antes de
# subir o projeto:
#   cp .env.example .env
#
# Variáveis marcadas como obrigatórias precisam de um valor real antes do
# primeiro "docker compose up". As demais têm um padrão sensato no código e
# só precisam ser definidas para mudar o comportamento padrão.
# ================================================================

# --- Porta exposta no host pelo docker compose ---
APP_PORT=8088

# --- Segurança (obrigatórias) ---

# NUNCA deixe TRUE em produção: expõe stack traces detalhados (inclusive
# variáveis de ambiente) para qualquer erro 500, e libera todas as origens
# de CORS/hosts.
DJANGO_DEBUG=FALSE

# Chave secreta do Django, usada para assinar sessões, tokens e cookies.
# Gere uma nova e exclusiva por instalação, nunca reaproveite este exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Chave de criptografia simétrica (Fernet) usada para guardar a senha SMTP
# cadastrada em Configurações > E-mail. Gere uma com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar essa chave depois de já haver uma senha SMTP salva torna esse dado
# ilegível — faça backup dela junto com o banco.
DJANGO_ENCRYPTION_KEY=

# --- Segurança (recomendadas em produção) ---

# Hosts/domínios autorizados a servir a aplicação, separados por vírgula.
# Só é aplicado quando DJANGO_DEBUG=FALSE.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para requisições autenticadas por cookie (proteção
# CSRF) — precisa incluir o esquema (http/https). Separadas por vírgula.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8088

# Origens liberadas para CORS, separadas por vírgula. Só é aplicado quando
# DJANGO_DEBUG=FALSE (em modo debug, todas as origens são liberadas).
DJANGO_CORS_ALLOWED_ORIGINS=

# Origens liberadas para conexão WebSocket (usado no dashboard de auditoria
# em tempo real), separadas por vírgula.
ALLOWED_WS_ORIGINS=http://localhost:8088

# Força redirecionamento HTTP -> HTTPS. Só ative se houver TLS terminado na
# frente da aplicação (proxy reverso/load balancer) — do contrário a
# aplicação fica inacessível (loop de redirecionamento).
DJANGO_SECURE_SSL_REDIRECT=FALSE

# Cabeçalho Cross-Origin-Opener-Policy enviado ao navegador.
DJANGO_SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin

# --- Localização ---
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LANGUAGE_CODE=pt-BR

# --- Banco de dados (opcional) ---
# Deixe as variáveis abaixo vazias/comentadas para configurar o banco pela
# interface guiada em /setup/ no primeiro acesso — cobre SQLite (padrão,
# zero configuração) ou PostgreSQL externo, com teste de conexão antes de
# salvar. Só preencha aqui se quiser pular o instalador e configurar na mão.
# DB_ENGINE=postgresql
# DB_NAME=monium
# DB_USER=monium
# DB_PASSWORD=
# DB_HOST=db
# DB_PORT=5432

# --- Autenticação LDAP (opcional) ---
# Deixe LDAP_SERVER_URI vazio para usar apenas login local (padrão). Ao
# preencher, o LDAP passa a ser tentado primeiro; se falhar ou o servidor
# estiver fora do ar, o login local continua funcionando como fallback.
# LDAP_SERVER_URI=ldaps://dc.empresa.local
# LDAP_BIND_DN=cn=service-account,dc=empresa,dc=local
# LDAP_BIND_PASSWORD=
# LDAP_USER_SEARCH_BASE_DN=ou=people,dc=empresa,dc=local
# LDAP_USER_SEARCH_FILTER=(uid=%(user)s)          # AD: (sAMAccountName=%(user)s)
# LDAP_GROUP_SEARCH_BASE_DN=ou=groups,dc=empresa,dc=local
#
# Organização (já existente no Monium) para a qual usuários autenticados via
# LDAP recebem Membership automaticamente. Sem isso, o usuário LDAP loga mas
# cai no onboarding normal (cria a própria organização).
# LDAP_TARGET_ORGANIZATION_SLUG=
#
# Papel padrão (viewer/operator/manager/admin) para quem não bate em nenhum
# grupo abaixo, e listas de nomes de grupo (CN) LDAP por papel, separados
# por vírgula. Papel "owner" não é atribuível via LDAP.
# LDAP_DEFAULT_ROLE=viewer
# LDAP_ROLE_GROUPS_ADMIN=
# LDAP_ROLE_GROUPS_MANAGER=
# LDAP_ROLE_GROUPS_OPERATOR=

# --- Armazenamento de arquivos (obrigatórias para upload funcionar) ---
# Avatar de usuário, logo de organização e fotos de item são delegados a um
# serviço HTTP externo de storage (autenticado por token), que não está
# incluído neste repositório. Sem essas duas variáveis, a aplicação sobe
# normalmente, mas qualquer upload de arquivo falha.
STORAGE_BASE_URL=
STORAGE_TOKEN=

# --- Logs (opcional, já tem padrão sensato no código) ---
# LOG_LEVEL=INFO
# LOG_DIR=logs
