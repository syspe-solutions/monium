msgstr "Excluir"

#: apps/inventory/web/templates/inventory/item_delete_confirm.html:4
#: apps/inventory/web/templates/inventory/item_delete_confirm.html:10
msgid "Delete item"
msgstr "Excluir item"

#: apps/inventory/web/templates/inventory/item_delete_confirm.html:17
msgid "This item cannot be permanently deleted because it has loan, maintenance or movement history, kept for audit purposes."
msgstr "Este item não pode ser excluído permanentemente porque possui histórico de empréstimos, manutenções ou movimentações, preservado para fins de auditoria."

#: apps/inventory/web/templates/inventory/item_delete_confirm.html:20
msgid "Mark it as \"Written Off\" instead — it stays out of active use, but its history is preserved."
msgstr "Marque-o como \"Baixado\" em vez disso — ele sai de uso ativo, mas seu histórico é preservado."

#: apps/inventory/web/templates/inventory/item_delete_confirm.html:25
msgid "Edit item"
msgstr "Editar item"

#: apps/inventory/web/templates/inventory/item_delete_confirm.html:34
msgid "This will permanently delete this item, its photo and its acquisition data. This cannot be undone."
msgstr "Isso excluirá permanentemente este item, sua foto e seus dados de aquisição. Essa ação não pode ser desfeita."

#: apps/inventory/web/templates/inventory/item_delete_confirm.html:41
#, python-format
msgid "Type \"%(code)s\" to confirm"
msgstr "Digite \"%(code)s\" para confirmar"

#: apps/inventory/web/views/item_delete_view.py:39
#, python-format
msgid ""
"Item \"%(name)s\" cannot be permanently deleted because it has loan, "
"maintenance or movement history. Mark it as \"Written Off\" instead to "
"keep it out of active use while preserving its history."
msgstr ""
"O item \"%(name)s\" não pode ser excluído permanentemente porque possui "
"histórico de empréstimos, manutenções ou movimentações. Marque-o como "
"\"Baixado\" em vez disso para tirá-lo de uso ativo preservando seu histórico."

#: apps/inventory/web/views/item_delete_view.py:47
msgid "The typed code doesn't match. The item was not deleted."
msgstr "O código digitado não confere. O item não foi excluído."

#: apps/inventory/web/views/item_delete_view.py:56
#, python-format
msgid "Item \"%(name)s\" deleted."
msgstr "Item \"%(name)s\" excluído."

#: apps/common/web/templates/common/errors/400.html:4
#: apps/common/web/templates/common/errors/400.html:16
msgid "Invalid request"
msgstr "Requisição inválida"

#: apps/common/web/templates/common/errors/400.html:20
msgid "We couldn't process your request. Check the submitted data and try again."
msgstr "Não foi possível processar sua solicitação. Verifique os dados enviados e tente novamente."

#: apps/common/web/templates/common/errors/403.html:4
#: apps/common/web/templates/common/errors/403.html:16
msgid "Access denied"
msgstr "Acesso negado"

#: apps/common/web/templates/common/errors/403.html:20
msgid "You don't have permission to access this page or resource."
msgstr "Você não tem permissão para acessar esta página ou recurso."

#: apps/common/web/templates/common/errors/403.html:24
msgid "If you believe this is a mistake, contact your organization's administrator."
msgstr "Se você acredita que isso é um engano, entre em contato com o administrador da sua organização."

#: apps/common/web/templates/common/errors/404.html:20
msgid "The page you're looking for doesn't exist or may have been moved."
msgstr "A página que você está procurando não existe ou pode ter sido movida."

#: apps/common/web/templates/common/errors/500.html:7
msgid "Server error"
msgstr "Erro no servidor"

#: apps/common/web/templates/common/errors/500.html:20
msgid "Something went wrong on our end"
msgstr "Algo deu errado do nosso lado"

#: apps/common/web/templates/common/errors/500.html:24
msgid "We've been notified and are already looking into it. Please try again in a few minutes."
msgstr "Já fomos notificados e estamos investigando. Tente novamente em alguns minutos."
