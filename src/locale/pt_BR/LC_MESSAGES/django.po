#: apps/pages/web/views.py:153
msgid "Team Management"
msgstr "Gestão de Equipe"

#: apps/pages/web/views.py:155
msgid "Collaborate with your entire team, with proper access control."
msgstr "Colabore com toda a sua equipe, com controle de acesso adequado."

#: apps/pages/web/views.py:157
msgid ""
"Create accounts for your team directly, with a role assigned right away to "
"control what each person can see and do. Operators can register items, while"
" managers and admins get broader access. Every action is logged with the "
"responsible user for full accountability."
msgstr ""
"Crie contas para seu time diretamente, com um papel atribuído imediatamente "
"para controlar o que cada pessoa pode ver e fazer. Operadores podem "
"cadastrar itens, enquanto gerentes e administradores têm acesso mais amplo. "
"Cada ação é registrada com o usuário responsável, garantindo total "
"rastreabilidade."

#: apps/pages/web/views.py:163
msgid "Organizations with multiple departments accessing inventory"
msgstr "Organizações com múltiplos departamentos acessando o inventário"

#: apps/pages/web/views.py:164
msgid "Operations managers delegating data entry"
msgstr "Gerentes de operações delegando entrada de dados"

#: apps/pages/web/views.py:165
msgid "Security-conscious teams needing role separation"
msgstr "Times preocupados com segurança que precisam de separação de funções"

#: apps/pages/web/views.py:166
msgid "Businesses with external auditors needing read-only access"
msgstr ""
"Empresas com auditores externos que precisam de acesso somente leitura"

#: apps/pages/web/views.py:169
msgid "Create"
msgstr "Criar"

#: apps/pages/web/views.py:169
msgid "Create an account for each team member directly from the Members page."
msgstr ""
"Crie uma conta para cada membro do time diretamente na página de Membros."

#: apps/pages/web/views.py:170
msgid "Set roles: Admin, Manager, Operator, or Viewer."
msgstr "Defina funções: Admin, Gerente, Operador ou Visualizador."

#: apps/pages/web/views.py:171
msgid "Control"
msgstr "Controlar"

#: apps/pages/web/views.py:171
msgid "Each role sees and can do only what's relevant to their function."
msgstr "Cada função vê e pode fazer apenas o que é relevante para sua função."

#: apps/pages/web/views.py:172
msgid "Audit"
msgstr "Auditoria"

#: apps/pages/web/views.py:172
msgid "Full action log: who changed what, when, and from where."
msgstr "Registro completo de ações: quem mudou o quê, quando e de onde."

#: apps/pages/web/views.py:175
msgid "Delegate data entry without losing control"
msgstr "Delegue entrada de dados sem perder controle"

#: apps/pages/web/views.py:176
msgid "Prevent unauthorized changes with role-based access"
msgstr "Previna alterações não autorizadas com acesso por função"

#: apps/pages/web/views.py:177
msgid "Full audit trail for compliance and security"
msgstr "Trilha completa de auditoria para conformidade e segurança"

#: apps/pages/web/views.py:178
msgid "Onboard new team members in under 2 minutes"
msgstr "Integre novos membros da equipe em menos de 2 minutos"

